import gleam/string

pub const build_dir = "./build/dev/javascript/_giolt_build"

pub const path = "./build/dev/javascript/_giolt_build/index.mjs"

const template =
  "// Generated by Giolt. Do not edit.
import * as conversation from \"../conversation/conversation.mjs\";
import * as app from \"{entry}\";

export default {
  async fetch(request, _env, _ctx) {
    if (typeof app.handle !== \"function\") {
      return new Response(
        \"[Giolt] {entry} does not export a `handle` function. The export was renamed from `handler` to `handle`.\",
        { status: 500 },
      );
    }

    const req = conversation.to_gleam_request(request);
    const response = await app.handle(req);

    const body = response?.body;
    if (typeof body !== \"object\" || body === null) {
      return new Response(
        \"[Giolt] `handle` must return a Response(conversation.ResponseBody), such as one built with conversation.Text.\",
        { status: 500 },
      );
    }

    return conversation.to_js_response(response);
  },
};
"

pub fn render(specifier: String) -> String {
  string.replace(template, "{entry}", specifier)
}
